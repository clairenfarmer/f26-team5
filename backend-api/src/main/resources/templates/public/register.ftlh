<#assign pageTitle="Register - HobbyCircles">
<#include "/shared/head.ftlh">
<#include "/shared/nav.ftlh">
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-9 mt-5">
            <div class="card shadow-sm p-4">
                <h3 class="mb-4">Get Started with Hobby Circles</h3>
                <p class="mb-4">How would you like to join?</p>
                <div class="d-grid gap-3 d-md-flex">
                    <a href="/register/individual" class="btn btn-warning btn-lg">Join as an Individual</a>
                    <a href="/register/group" class="btn btn-outline-dark btn-lg">Create a Group</a>
                </div>
                <p class="mt-4 mb-0">Already have an account? <a href="/login">Log in</a></p>
            </div>
        </div>
    </div>
</div>

</body>

</html>
